<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings xmlns="https://jakarta.ee/xml/ns/persistence/orm" version="3.0">
  <entity class="com.empresa.reembolsos.dominio.SolicitudReembolso" access="FIELD">
    <table name="solicitudes"/>
    <attributes>
      <id name="id"><generated-value strategy="IDENTITY"/></id>
      <basic name="empleadoId"><column nullable="false"/></basic>
      <basic name="categoria"><column nullable="false"/><enumerated>STRING</enumerated></basic>
      <basic name="montoSolicitado"><column nullable="false" precision="19" scale="2"/></basic>
      <basic name="montoAprobado"><column precision="19" scale="2"/></basic>
      <basic name="fechaGasto"><column nullable="false"/></basic>
      <basic name="diasViaje"/>
      <basic name="documentosSoporte"/>
      <basic name="estado"><column nullable="false"/><enumerated>STRING</enumerated></basic>
    </attributes>
  </entity>
</entity-mappings>
